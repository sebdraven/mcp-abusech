*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Built binaries. They belong in a release, never in the history: a Go binary
# is tens of megabytes and cannot be removed from a repository once committed.
bin/
